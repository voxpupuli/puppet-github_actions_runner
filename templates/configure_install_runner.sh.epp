<%- | Optional[Any] $personal_access_token = undef,
      Optional[String] $token_url = undef,
      String $instance_name,
      String $root_dir,
      String $url,
      String $hostname,
      String $assured_labels,
      Optional[Any] $repo_token = undef,
      Optional[String[1]] $runner_group = undef,
      Boolean $disable_update,
      Optional[String[1]] $http_proxy = undef,
      Optional[String[1]] $https_proxy = undef,
      Optional[String[1]] $no_proxy = undef,
| -%>
#!/bin/bash
# THIS FILE IS MANAGED BY PUPPET
# Configure the action runner after the package file has been downloaded.
set -e

<% if $repo_token { -%>
# Use manually provided registration token.
TOKEN=<%= $repo_token %>
<% } else {-%>
# Set proxy environment variables if configured (for API call).
<% if $http_proxy { -%>
export http_proxy="<%= $http_proxy %>"
<% } -%>
<% if $https_proxy { -%>
export https_proxy="<%= $https_proxy %>"
<% } -%>
<% if $no_proxy { -%>
export no_proxy="<%= $no_proxy %>"
<% } -%>

# Get registration token via API.
TOKEN=$(curl -s -XPOST -H "authorization: token <%= $personal_access_token %>"  \
    <%= $token_url %> | jq -r .token)
<% } -%>

# Allow root
export RUNNER_ALLOW_RUNASROOT=true

# (Optional) Remove previous config.
<%= $root_dir %>/<%= $instance_name %>/config.sh remove --token ${TOKEN}

# Configure the runner.
<%= $root_dir %>/<%= $instance_name %>/config.sh \
  --unattended                                   \
  --replace                                      \
  --name <%= $hostname %>-<%= $instance_name %>  \
  --url <%= $url %>                              \
  --token ${TOKEN}                               \
  <%- if $runner_group { -%>
  --runnergroup <%= $runner_group %>             \
  <%- } -%>
  <%- if $disable_update { -%>
  --disableupdate                                \
  <%- } -%>
  <%= $assured_labels %>

# Copy service endpoint script.
if [ ! -f <%= $root_dir %>/<%= $instance_name %>/runsvc.sh ]; then
  cp <%= $root_dir %>/<%= $instance_name %>/bin/runsvc.sh <%= $root_dir %>/<%= $instance_name %>/runsvc.sh
  chmod 755 <%= $root_dir %>/<%= $instance_name %>/runsvc.sh
fi
